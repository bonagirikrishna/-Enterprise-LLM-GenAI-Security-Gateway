# ============ Core ============
GW_ENVIRONMENT=development
# Comma-separated API keys clients must send in the X-API-Key header
GW_GATEWAY_API_KEYS=dev-key-change-me

# ============ Upstream LLM provider ============
# auto = pick provider from model name (claude-* -> Anthropic, else OpenAI-compatible)
GW_LLM_PROVIDER=auto
GW_OPENAI_API_KEY=sk-your-openai-key
GW_OPENAI_BASE_URL=https://api.openai.com/v1
GW_OPENAI_MODEL=gpt-4o-mini
GW_ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GW_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============ Infrastructure ============
GW_REDIS_URL=redis://localhost:6379/0
GW_DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway

# ============ Security policy ============
GW_BLOCK_INJECTION=true
GW_INJECTION_THRESHOLD=0.7        # score 0..1 above which a prompt is blocked
GW_REDACT_PII=true
GW_REDACT_RESPONSE_PII=true
GW_PII_LANGUAGES=en

# ============ Rate limiting ============
GW_RATE_LIMIT_REQUESTS=100
GW_RATE_LIMIT_WINDOW_SECONDS=60

# ============ Semantic cache ============
GW_SEMANTIC_CACHE_ENABLED=true
GW_SEMANTIC_CACHE_THRESHOLD=0.92  # cosine similarity to count as cache hit
GW_SEMANTIC_CACHE_TTL=3600
GW_SEMANTIC_CACHE_MAX_ENTRIES=500

# ============ Rebuff (optional, needs OpenAI + Pinecone) ============
GW_REBUFF_ENABLED=false
GW_OPENAI_API_KEY_FOR_REBUFF=
GW_OPENAI_MODEL_FOR_REBUFF=gpt-3.5-turbo
GW_PINECONE_API_KEY=
GW_PINECONE_ENVIRONMENT=
GW_PINECONE_INDEX_NAME=rebuff